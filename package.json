{
  "name": "pulsemic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build --logLevel warn && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/noto-sans-tc": "^5.2.9",
    "discord.js": "14.27.0",
    "express": "^5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "werift": "0.25.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
